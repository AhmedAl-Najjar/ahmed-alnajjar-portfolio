{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahmed-alnajjar-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
